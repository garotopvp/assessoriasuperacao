# Variáveis de Ambiente de Produção

# Exemplo: URL da API
API_URL=https://api.your-production-app.com

# Exemplo: Chave de API (NÃO COLOQUE CHAVES SENSÍVEIS DIRETAMENTE AQUI EM PRODUÇÃO REAL)
# Para produção, use um gerenciador de segredos ou variáveis de ambiente do sistema.
# API_KEY=your_production_api_key

# Exemplo: Nome do ambiente
NODE_ENV=production

# Exemplo: Porta da aplicação
PORT=80
